package progress

func rp_clamp(current, total) {
    if current < 0 {
        return 0
    }
    if total > 0 and current > total {
        return total
    }
    return current
}

func rp_width(width) {
    if width < 0 {
        return 0
    }
    return width
}

func rp_filled_width(current, total, width) {
    if width <= 0 or total <= 0 {
        return 0
    }
    return int(rp_clamp(current, total) * width / total)
}

func Percent(current, total) {
    if total <= 0 {
        return 100
    }
    return int(rp_clamp(current, total) * 100 / total)
}

func CustomBar(current, total, width, fill, empty, left, right) {
    let bar_width = rp_width(width)
    let done = rp_filled_width(current, total, bar_width)
    let body = fill.repeat(done) + empty.repeat(bar_width - done)
    return left + body + right + " " + string(Percent(current, total)) + "%"
}

func Bar(current, total, width) {
    return CustomBar(current, total, width, "█", "░", "[", "]")
}

func Ascii(current, total, width) {
    return CustomBar(current, total, width, "#", "-", "[", "]")
}

func Dots(current, total, width) {
    return CustomBar(current, total, width, "●", "○", "(", ")")
}

func Arrow(current, total, width) {
    let bar_width = rp_width(width)
    let done = rp_filled_width(current, total, bar_width)
    if done >= bar_width {
        return "[" + "=".repeat(bar_width) + "] " + string(Percent(current, total)) + "%"
    }
    if bar_width == 0 {
        return "[] " + string(Percent(current, total)) + "%"
    }
    if done <= 0 {
        return "[>" + ".".repeat(bar_width - 1) + "] " + string(Percent(current, total)) + "%"
    }
    let body = "[" + "=".repeat(done) + ">" + ".".repeat(bar_width - done - 1) + "] "
    return body + string(Percent(current, total)) + "%"
}

func ShadeBar(current, total, width) {
    return CustomBar(current, total, width, "▓", "░", "[", "]")
}

func MediumBar(current, total, width) {
    return CustomBar(current, total, width, "▒", "░", "[", "]")
}

func ThinBar(current, total, width) {
    return CustomBar(current, total, width, "━", "─", "[", "]")
}

func DoubleBar(current, total, width) {
    return CustomBar(current, total, width, "═", "─", "[", "]")
}

func SquareBar(current, total, width) {
    return CustomBar(current, total, width, "■", "□", "[", "]")
}

func DiamondBar(current, total, width) {
    return CustomBar(current, total, width, "◆", "◇", "[", "]")
}

func StarBar(current, total, width) {
    return CustomBar(current, total, width, "★", "☆", "[", "]")
}

func HeartBar(current, total, width) {
    return CustomBar(current, total, width, "♥", "♡", "[", "]")
}

func PlusBar(current, total, width) {
    return CustomBar(current, total, width, "+", "-", "[", "]")
}

func HashBar(current, total, width) {
    return CustomBar(current, total, width, "#", "-", "[", "]")
}

func EqualBar(current, total, width) {
    return CustomBar(current, total, width, "=", ".", "[", "]")
}

func DotBar(current, total, width) {
    return CustomBar(current, total, width, "●", "·", "[", "]")
}

func WaveBar(current, total, width) {
    return CustomBar(current, total, width, "~", "·", "[", "]")
}

func PipeBar(current, total, width) {
    return CustomBar(current, total, width, "|", ".", "[", "]")
}

func SlashBar(current, total, width) {
    return CustomBar(current, total, width, "/", ".", "[", "]")
}

func PixelBar(current, total, width) {
    return CustomBar(current, total, width, "▪", "▫", "[", "]")
}

func SegmentBar(current, total, width) {
    return CustomBar(current, total, width, "▰", "▱", "[", "]")
}

func BrickBar(current, total, width) {
    return CustomBar(current, total, width, "▉", "▏", "[", "]")
}

func BlockSpaceBar(current, total, width) {
    return CustomBar(current, total, width, "█", " ", "[", "]")
}

func ChevronBar(current, total, width) {
    return CustomBar(current, total, width, ">", "-", "[", "]")
}

func CircleFrameBar(current, total, width) {
    return CustomBar(current, total, width, "●", "·", "(", ")")
}

func AngleFrameBar(current, total, width) {
    return CustomBar(current, total, width, "━", "─", "<", ">")
}

func CurlyFrameBar(current, total, width) {
    return CustomBar(current, total, width, "#", "-", "{", "}")
}

func PipeFrameBar(current, total, width) {
    return CustomBar(current, total, width, "=", ".", "|", "|")
}

func ByteBar(current, total, width) {
    return Bar(current, total, width) + " " + ByteFormat(rp_clamp(current, total)) + "/" + ByteFormat(total)
}